import { Head, Link, useForm } from '@inertiajs/react';
import type { FormEvent } from 'react';
{%- if edit %}

import type { {{ k.type_name }} } from '@/types/{{ k.type_module }}';
{%- endif %}

{% if edit -%}
/** `GET {{ m.url }}/{id}/edit` (`edit` in `app/controllers/{{ m.table }}.rs`): the form that `update` saves. */
export default function Edit({ {{ k.var }} }: { {{ k.var }}: {{ k.type_name }} }) {
    const form = useForm({
{%- for f in m.form_fields %}
        {{ f.name }}: {{ f.edit_value }},
{%- endfor %}
    });
{%- else -%}
/** `GET {{ m.url }}/create` (`create` in `app/controllers/{{ m.table }}.rs`): the form that `store` saves. */
export default function Create() {
    const form = useForm({
{%- for f in m.form_fields %}
        {{ f.name }}: {{ f.create_value }},
{%- endfor %}
    });
{%- endif %}

    function submit(event: FormEvent) {
        event.preventDefault();
{%- if m.has_files %}
{%- if k.bools %}
        // With a file the form goes up as multipart/form-data, where a checkbox is the text `true` or `false`.
        form.transform((data) => ({
            ...data,
{%- for b in k.bools %}
            {{ b }}: String(data.{{ b }}),
{%- endfor %}
        }));
{%- endif %}
        form.{% if edit %}put(`{{ m.url }}/${{ "{" }}{{ k.var }}.id}`{% else %}post('{{ m.url }}'{% endif %}, { forceFormData: true });
{%- else %}
{%- if k.numbers %}
        // Number fields hold the text of their input; the server reads numbers (an empty field is a missing value).
        form.transform((data) => ({
            ...data,
{%- for n in k.numbers %}
            {{ n }}: data.{{ n }} === '' ? '' : Number(data.{{ n }}),
{%- endfor %}
        }));
{%- endif %}
        form.{% if edit %}put(`{{ m.url }}/${{ "{" }}{{ k.var }}.id}`){% else %}post('{{ m.url }}'){% endif %};
{%- endif %}
    }

    return (
        <main className="mx-auto max-w-3xl px-4 py-12 sm:px-6">
{%- if edit %}
            <Head title="Edit {{ m.lower }}" />
            <h1 className="text-3xl font-bold tracking-tight">
                Edit {{ m.lower }} {{ "{" }}{{ k.var }}.id}
            </h1>
{%- else %}
            <Head title="New {{ m.lower }}" />
            <h1 className="text-3xl font-bold tracking-tight">New {{ m.lower }}</h1>
{%- endif %}
            <form onSubmit={submit} className="panel mt-8 space-y-5">
{%- for f in m.form_fields %}
                <div>
                    <label htmlFor="{{ f.name }}" className="form-label">
                        {{ f.label }}
                    </label>
{%- if f.checkbox %}
                    <input
                        id="{{ f.name }}"
                        name="{{ f.name }}"
                        type="checkbox"
                        className="mt-2 h-4 w-4 accent-molten-700"
                        checked={form.data.{{ f.name }}}
                        onChange={(e) => form.setData('{{ f.name }}', e.target.checked)}
                        aria-invalid={form.errors.{{ f.name }} ? true : undefined}
                        aria-describedby={form.errors.{{ f.name }} ? '{{ f.name }}-error' : undefined}
                    />
{%- elif f.file %}
                    <input
                        id="{{ f.name }}"
                        name="{{ f.name }}"
                        type="file"
{%- if f.required and not edit %}
                        required
{%- endif %}
                        className="form-input"
                        onChange={(e) => form.setData('{{ f.name }}', e.target.files?.[0] ?? null)}
                        aria-invalid={form.errors.{{ f.name }} ? true : undefined}
                        aria-describedby={form.errors.{{ f.name }} ? '{{ f.name }}-error' : undefined}
                    />
{%- elif f.textarea %}
                    <textarea
                        id="{{ f.name }}"
                        name="{{ f.name }}"
{%- if f.required %}
                        required
{%- endif %}
                        className="form-input"
                        value={form.data.{{ f.name }}}
                        onChange={(e) => form.setData('{{ f.name }}', e.target.value)}
                        aria-invalid={form.errors.{{ f.name }} ? true : undefined}
                        aria-describedby={form.errors.{{ f.name }} ? '{{ f.name }}-error' : undefined}
                    />
{%- else %}
                    <input
                        id="{{ f.name }}"
                        name="{{ f.name }}"
                        type="{% if f.number %}number{% else %}text{% endif %}"
{%- if f.step_any %}
                        step="any"
{%- endif %}
{%- if f.required %}
                        required
{%- endif %}
                        className="form-input"
                        value={form.data.{{ f.name }}}
                        onChange={(e) => form.setData('{{ f.name }}', e.target.value)}
                        aria-invalid={form.errors.{{ f.name }} ? true : undefined}
                        aria-describedby={form.errors.{{ f.name }} ? '{{ f.name }}-error' : undefined}
                    />
{%- endif %}
                    {form.errors.{{ f.name }} && (
                        <p id="{{ f.name }}-error" className="form-error">
                            {form.errors.{{ f.name }}}
                        </p>
                    )}
                </div>
{%- endfor %}
                <div className="flex items-center gap-3">
                    <button type="submit" className="btn-primary" disabled={form.processing}>
                        Save
                    </button>{' '}
                    <Link href="{{ m.url }}" className="btn-secondary">
                        Cancel
                    </Link>
                </div>
            </form>
        </main>
    );
}
