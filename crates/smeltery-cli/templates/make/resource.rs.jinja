/// Where uploads go, under `storage/app` (served at `/storage/{{ m.table }}/…` after `smeltery storage:link`).
///
/// The `mimes` rules of the forms list the file types accepted. Add types there as needed, but never `html`, `svg`,
/// `xml` or `js`: a browser runs those as pages of this app.
const UPLOADS: &str = "{{ m.uploads }}";

/// Stores an uploaded file in [`UPLOADS`]; returns its path under `storage/app/public`.
async fn store_upload(file: Option<&UploadedFile>) -> Result<Option<String>> {
    let Some(file) = file else {
        return Ok(None);
    };
    let stored = file.store(UPLOADS).await?;
    Ok(Some(
        stored.strip_prefix("public/").unwrap_or(&stored).to_owned(),
    ))
}
{%- endif %}
{%- if m.search %}

/// The query string of the list: `?q=` (the search text; empty lists every record), with `?page=` read by
/// `PageQuery`.
#[derive(Debug, Deserialize)]
pub struct SearchQuery {
    #[serde(default)]
    pub q: String,
}
{%- endif %}
{%- if k %}
{%- if m.search %}

/// `GET {{ m.url }}?q=…&page=…`: one page of records matching the search, ranked{% if m.search.highlight %} (highlighted: `{{ m.search.highlight }}`){% endif %}
/// (`{{ k.index_file }}`). It searches every record, as the list shows every record: add `.within(…)` /
/// `.where_eq(…)` to the search when records are private.
pub async fn index(
    prospect: Prospect,
    Query(search): Query<SearchQuery>,
    page: PageQuery,
) -> Result<Page> {
    // The text as the search uses it (at most `PROSPECT_MAX_QUERY_LENGTH` characters), also shown in the search box.
    let q: String = search
        .q
        .chars()
        .take(prospect.settings().query_length())
        .collect();
    let {{ m.table }} = {{ m.pascal }}::search(&prospect, &q)
{%- if m.search.highlight %}
        .highlight(["{{ m.search.highlight }}"])
{%- endif %}
        .paginate(page)
        .await?;
    Ok(alloy::render("{{ k.index }}")
        .with("{{ k.list_var }}", {{ m.table }})
        .with("q", q))
}
{%- else %}

/// `GET {{ m.url }}`: every record (`{{ k.index_file }}`).
pub async fn index(db: Db) -> Result<Page> {
    let {{ m.table }} = {{ m.pascal }}::all(&db).await?;
    Ok(alloy::render("{{ k.index }}").with("{{ k.list_var }}", {{ m.table }}))
}
{%- endif %}

