/// `PUT {{ m.url }}/{{ "{" ~ m.snake ~ "}" }}`: saves the changes.
pub async fn update(
    app: App,
    db: Db,
    session: Session,
    Found({{ m.snake }}): Found<{{ m.pascal }}>,
    Valid({% if m.form_fields %}form{% else %}_form{% endif %}): Valid<{{ m.pascal }}{% if m.update_form %}UpdateForm{% else %}Form{% endif %}>,
) -> Result<Redirect> {
{%- for f in m.form_fields %}
{%- if f.file %}
    let {{ f.name }}_path = store_upload(form.{{ f.name }}.as_ref()).await?;
{%- endif %}
{%- endfor %}
{%- if not m.form_fields %}
    let {{ m.snake }} = {{ m.snake }}.update(&db, |_m| {}).await?;
{%- else %}
    let {{ m.snake }} = {{ m.snake }}
        .update(&db, |m| {
{%- for f in m.form_fields %}
{%- if f.file %}
            if let Some(path) = {{ f.name }}_path {
                m.{{ f.name }} = Set({% if f.nullable %}Some(path){% else %}path{% endif %});
            }
{%- else %}
            m.{{ f.name }} = Set(form.{{ f.name }});
{%- endif %}
{%- endfor %}
        })
        .await?;
{%- endif %}
    session.flash("status", "{{ m.title }} updated.");
    let id = {{ m.snake }}.id.to_string();
    let url = app.url("{{ m.route }}.show", &[("{{ m.snake }}", &id)])?;
    Ok(Redirect::to(&url))
}

/// `DELETE {{ m.url }}/{{ "{" ~ m.snake ~ "}" }}`: deletes the record.
pub async fn destroy(
    app: App,
    db: Db,
    session: Session,
    Found({{ m.snake }}): Found<{{ m.pascal }}>,
) -> Result<Redirect> {
    {{ m.snake }}.delete(&db).await?;
    session.flash("status", "{{ m.title }} deleted.");
    Ok(Redirect::to(&app.url("{{ m.route }}.index", &[])?))
}
