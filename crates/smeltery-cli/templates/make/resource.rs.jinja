/// `POST {{ m.url }}`: saves a new record.
pub async fn store(
    app: App,
    db: Db,
    session: Session,
    Valid({% if m.form_fields %}form{% else %}_form{% endif %}): Valid<{{ m.pascal }}Form>,
) -> Result<Redirect> {
{%- for f in m.form_fields %}
{%- if f.file %}
    let {{ f.name }}_path = store_upload(form.{{ f.name }}.as_ref()).await?;
{%- endif %}
{%- endfor %}
    {{ m.pascal }}::create(
        &db,
        {{ m.snake }}::ActiveModel {
{%- for f in m.form_fields %}
{%- if f.file %}
            {{ f.name }}: Set({{ f.name }}_path{% if not f.nullable %}.unwrap_or_default(){% endif %}),
{%- else %}
            {{ f.name }}: Set(form.{{ f.name }}),
{%- endif %}
{%- endfor %}
            ..Default::default()
        },
    )
    .await?;
    session.flash("status", "{{ m.title }} created.");
    Ok(Redirect::to(&app.url("{{ m.route }}.index", &[])?))
}

