/// `GET {{ m.url }}?q=…&page=…`: one page of records matching the search, ranked{% if m.search.highlight %} (highlighted: `{{ m.search.highlight }}`){% endif %}.
/// It searches every record, as the list shows every record: add `.within(…)` / `.where_eq(…)` to the search when
/// records are private.
pub async fn index(
    prospect: Prospect,
    Query(search): Query<SearchQuery>,
    page: PageQuery,
) -> Result<IndexView> {
    // The text as the search uses it (at most `PROSPECT_MAX_QUERY_LENGTH` characters), also shown in the search box.
    let q: String = search
        .q
        .chars()
        .take(prospect.settings().query_length())
        .collect();
    let hits = {{ m.pascal }}::search(&prospect, &q)
{%- if m.search.highlight %}
        .highlight(["{{ m.search.highlight }}"])
{%- endif %}
        .paginate(page)
        .await?;
    Ok(IndexView {
        q,
        {{ m.table }}: hits.map(|hit| {{ m.pascal }}Row {
{%- if m.search.highlight %}
            label: hit
                .highlights
                .get("{{ m.search.highlight }}")
                .map(|h| h.segments().to_vec())
                .unwrap_or_default(),
{%- endif %}
            {{ m.snake }}: hit.into_model(),
        }),
    })
}
{%- else -%}
/// `GET {{ m.url }}`: every record.
pub async fn index(db: Db) -> Result<IndexView> {
    Ok(IndexView {
        {{ m.table }}: {{ m.pascal }}::all(&db).await?,
    })
}
{%- endif %}

