{% if m.search -%}
<!-- `GET {{ m.url }}?q=…&page=…` (`index` in `app/controllers/{{ m.table }}.rs`): the {{ m.plural_lower }} matching the search, ranked. -->
<script setup lang="ts">
import { Head, Link, router } from '@inertiajs/vue3';
import { ref, watch } from 'vue';

import type { {{ k.type_name }} } from '@/types/{{ k.type_module }}';

/** One part of a highlighted text: rendered as text, the matched parts inside `<mark>` (never as HTML). */
interface Segment {
    text: string;
    matched: boolean;
}

/** A search result: the record, its relevance (`null` without search terms) and its highlighted columns. */
type Hit = {{ k.type_name }} & { _score: number | null; _highlights: Partial<Record<string, Segment[]>> };

/** One page of results (`smeltery::db::Page`). */
interface Results {
    items: Hit[];
    page: number;
    per_page: number;
    total: number;
    last_page: number;
}

const props = defineProps<{ {{ k.list_var }}: Results; q: string }>();
const search = ref(props.q);
let timer: ReturnType<typeof setTimeout> | undefined;

// Search as the visitor types, 300 ms after the last key; the page and its scroll position stay.
watch(search, (value) => {
    clearTimeout(timer);
    timer = setTimeout(() => {
        router.get('{{ m.url }}', value ? { q: value } : {}, { preserveState: true, preserveScroll: true, replace: true });
    }, 300);
});
{%- if m.search.highlight %}

/** The highlighted parts of a result's {{ m.search.highlight }}, or the whole text when the search has no terms. */
function parts({{ k.var }}: Hit): Segment[] {
    return {{ k.var }}._highlights.{{ m.search.highlight }} ?? [{ text: {{ k.var }}.{{ m.search.highlight }}, matched: false }];
}
{%- endif %}
</script>

<template>
    <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <Head title="{{ m.plural_title }}" />
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-3xl font-bold tracking-tight">{{ m.plural_title }}</h1>
            <Link href="{{ m.url }}/create" class="btn-primary">New {{ m.lower }}</Link>
        </div>
        <input v-model="search" type="search" placeholder="Search {{ m.plural_lower }}" aria-label="Search {{ m.plural_lower }}" class="form-input mt-8 w-full" />
        <ul class="panel mt-4 divide-y divide-ash-200 p-0 dark:divide-forge-800">
            <li v-for="{{ k.var }} in {{ k.list_var }}.items" :key="{{ k.var }}.id">
                <Link :href="`{{ m.url }}/${{ "{" }}{{ k.var }}.id}`" class="block px-6 py-4 font-medium hover:bg-ash-100 focus-visible:outline-2 focus-visible:outline-molten-500 dark:hover:bg-forge-800">
{%- if m.search.highlight %}
                    <template v-for="(part, i) in parts({{ k.var }})" :key="i"><mark v-if="part.matched">{{ "{{ part.text }}" }}</mark><template v-else>{{ "{{ part.text }}" }}</template></template>
{%- else %}
                    {{ k.vue_label }}
{%- endif %}
                </Link>
            </li>
            <li v-if="{{ k.list_var }}.items.length === 0" class="px-6 py-4 text-stone-600 dark:text-stone-400">
                {{ "{{" }} q ? 'No {{ m.plural_lower }} match your search.' : 'No {{ m.plural_lower }} yet.' {{ "}}" }}
            </li>
        </ul>
        <nav v-if="{{ k.list_var }}.last_page > 1" class="mt-6 flex items-center justify-between gap-4 text-sm" aria-label="Pages">
            <Link v-if="{{ k.list_var }}.page > 1" href="{{ m.url }}" :data="{ q, page: {{ k.list_var }}.page - 1 }" preserve-state class="btn-secondary">Previous</Link>
            <span v-else />
            <span class="text-stone-600 dark:text-stone-400">Page {{ "{{ " ~ k.list_var ~ ".page }}" }} of {{ "{{ " ~ k.list_var ~ ".last_page }}" }}</span>
            <Link v-if="{{ k.list_var }}.page < {{ k.list_var }}.last_page" href="{{ m.url }}" :data="{ q, page: {{ k.list_var }}.page + 1 }" preserve-state class="btn-secondary">Next</Link>
            <span v-else />
        </nav>
    </main>
</template>
{%- else -%}
<!-- `GET {{ m.url }}` (`index` in `app/controllers/{{ m.table }}.rs`): every {{ m.lower }}. -->
<script setup lang="ts">
import { Head, Link } from '@inertiajs/vue3';

import type { {{ k.type_name }} } from '@/types/{{ k.type_module }}';

defineProps<{ {{ k.list_var }}: {{ k.type_name }}[] }>();
</script>

<template>
    <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <Head title="{{ m.plural_title }}" />
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-3xl font-bold tracking-tight">{{ m.plural_title }}</h1>
            <Link href="{{ m.url }}/create" class="btn-primary">New {{ m.lower }}</Link>
        </div>
        <ul class="panel mt-8 divide-y divide-ash-200 p-0 dark:divide-forge-800">
            <li v-for="{{ k.var }} in {{ k.list_var }}" :key="{{ k.var }}.id">
                <Link :href="`{{ m.url }}/${{ "{" }}{{ k.var }}.id}`" class="block px-6 py-4 font-medium hover:bg-ash-100 focus-visible:outline-2 focus-visible:outline-molten-500 dark:hover:bg-forge-800">{{ k.vue_label }}</Link>
            </li>
            <li v-if="{{ k.list_var }}.length === 0" class="px-6 py-4 text-stone-600 dark:text-stone-400">No {{ m.plural_lower }} yet.</li>
        </ul>
    </main>
</template>
{%- endif %}
