import '../css/app.css';

import { createInertiaApp } from '@inertiajs/vue3';

import AppLayout from '@/layouts/AppLayout.vue';
{%- if anvil %}
import { startEcho } from '@/echo';
{%- endif %}

const appName = import.meta.env.VITE_APP_NAME || 'Smeltery';

// The pages live in resources/js/pages/: a controller's `alloy::render("auth/Login")` shows pages/auth/Login.vue
// (@inertiajs/vite adds the resolver). Every page sits in the app layout.
createInertiaApp({
    title: (title) => (title ? `${title} · ${appName}` : appName),
    layout: () => AppLayout,
    progress: { color: '#ff4a1c' },
{%- if anvil %}
    // Connects Echo (resources/js/echo.ts) with the app's public Anvil key from the first page's shared props.
    withApp: (_app, { page }) => {
        startEcho(page.props.app.anvil_key);
    },
{%- endif %}
});
