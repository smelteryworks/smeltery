#[test]
fn the_dashboard_presence_channel_shares_only_the_member_id() {
    let app = TestApp::new({{ lib_name }}::build);
    let user = app
        .block_on(UserFactory.create(&app.db()))
        .expect("creating a user");
    let socket = TestSocket::connect(app.app());
    // Guests are refused.
    assert_eq!(
        authorize(&app, socket.socket_id(), "presence-dashboard", None).status(),
        403
    );
    app.acting_as(user.id);
    let (_auth, data) = presence_of(&authorize(
        &app,
        socket.socket_id(),
        "presence-dashboard",
        None,
    ))
    .expect("a signed-in user joins");
    // Every other member receives this `channel_data`: the id only, no name and no e-mail address.
    let expected =
        smeltery::json!({ "user_id": user.id.to_string(), "user_info": { "id": user.id } });
    assert_eq!(data, expected.to_string());
    assert!(!data.contains(&user.name), "{data}");
    assert!(!data.contains(&user.email), "{data}");
}

#[test]
fn notify_me_sends_the_signed_in_user_an_event() {
    let app = TestApp::new({{ lib_name }}::build);
    let user = app
        .block_on(UserFactory.create(&app.db()))
        .expect("creating a user");
    let spy = AnvilSpy::of(app.app());
    // Guests are sent to the login page; nothing is sent.
    assert_eq!(app.post_form("/notify-me", &[]).status(), 303);
    assert!(spy.nothing_sent());
    app.acting_as(user.id);
    assert_eq!(app.post_form("/notify-me", &[]).status(), 303);
    assert!(spy.sent_on(
        &format!("private-users.{}", user.id),
        r"App\Events\UserNotified"
    ));
}
