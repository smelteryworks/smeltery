/// A fresh app with the demo user (`demo@example.com` / `password`).
fn app_with_demo_user() -> TestApp {
    let app = TestApp::new({{ lib_name }}::build);
    let db = app.db();
    app.block_on(DatabaseSeeder.run(&db))
        .expect("seeding the demo user");
    app
}
