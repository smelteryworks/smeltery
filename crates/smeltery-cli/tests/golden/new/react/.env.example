APP_NAME="My App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=

# Vite compiles every VITE_ value into the JavaScript: they are public.
VITE_APP_NAME="My App"

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

LOG_LEVEL=debug
LOG_FILE=storage/logs/smeltery.log

SESSION_DRIVER=database
SESSION_LIFETIME=120

AUTH_VERIFICATION_EXPIRE=60
# Seconds a password confirmation lasts (the `password.confirm` middleware).
AUTH_PASSWORD_TIMEOUT=10800

DATABASE_URL=sqlite://database/database.sqlite?mode=rwc

CACHE_STORE=database
CACHE_PREFIX=

# Where queued jobs wait: database, redis (the `redis` feature of smeltery) or memory.
QUEUE_DRIVER=database
# The Redis server of the redis cache store, PubSub driver and queue driver.
# REDIS_URL=redis://127.0.0.1:6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="My App"
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls

WATCHFIRE_DASHBOARD=local
WATCHFIRE_API_ADDR=
WATCHFIRE_ALERT_WEBHOOK=
WATCHFIRE_ALERT_MAIL=
