APP_NAME="My App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

LOG_LEVEL=debug
LOG_FILE=storage/logs/smeltery.log

SESSION_DRIVER=database
SESSION_LIFETIME=120

# WebSockets and broadcasting (Anvil), on this app's own port (SERVER_PORT). The public key and the signing secret
# are derived from APP_KEY; the key is the `<key>` of `/app/<key>` in `smeltery route:list`.
# A mobile app or another client built with the key needs a fixed one: set ANVIL_APP_KEY to any string of letters,
# digits, `-` and `_` (it is public), since a new APP_KEY changes the derived key. ANVIL_APP_SECRET is only needed
# when another deployment must sign subscriptions too.
# ANVIL_APP_KEY=
# Origins allowed besides APP_URL's, comma-separated (such as capacitor://localhost for a mobile app's web view).
# ANVIL_ALLOWED_ORIGINS=
# Sockets this process holds (below SERVER_MAX_CONNECTIONS).
# ANVIL_MAX_CONNECTIONS=2048
# The sockets in their own `anvil` process (ANVIL_IN_SERVE=false for serve): the README's "A separate socket process".
# ANVIL_IN_SERVE=true
# ANVIL_SERVER_HOST=127.0.0.1
# ANVIL_SERVER_PORT=8080

# CORS for hybrid and other-origin apps that call /api/ with a bearer token (never cookies): their exact origins,
# comma-separated, such as capacitor://localhost or tauri://localhost; CORS_PATHS sets the paths (default /api/).
# CORS_ALLOWED_ORIGINS=
# CORS_PATHS=/api/

DATABASE_URL=sqlite://database/database.sqlite?mode=rwc

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="My App"
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
