APP_NAME="Headless Demo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

LOG_LEVEL=debug
LOG_FILE=storage/logs/smeltery.log

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

DATABASE_URL=sqlite://database/database.sqlite?mode=rwc

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Headless Demo"
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls

WATCHFIRE_DASHBOARD=local
WATCHFIRE_API_ADDR=127.0.0.1:8001
WATCHFIRE_ALERT_WEBHOOK=
WATCHFIRE_ALERT_MAIL=

POLLER_URL=
POLLER_EVERY_SECS=30
FLAKY_FAILURE_PERCENT=30
FLAKY_SEED=42
FLAKY_BATCH_SECS=5
FLAKY_BATCHES_PER_RUN=6
