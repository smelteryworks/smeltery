APP_NAME="Web Demo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

LOG_LEVEL=debug
LOG_FILE=storage/logs/smeltery.log

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

DATABASE_URL=sqlite://database/database.sqlite?mode=rwc

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Web Demo"
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls

WATCHFIRE_DASHBOARD=local
WATCHFIRE_API_ADDR=
WATCHFIRE_ALERT_WEBHOOK=
WATCHFIRE_ALERT_MAIL=

SCRAPER_START_URL=
SCRAPER_MAX_PAGES=50
SCRAPER_DELAY_MS=2000
SCRAPER_RETRIES=3
